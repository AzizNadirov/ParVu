{
  "name": "Material Light",
  "description": "Material Design 3 light theme",
  "author": "ParVu",
  "version": "1.0",
  "colors": {
    "background": "#FEF7FF",
    "foreground": "#1D1B20",
    "button_background": "#E8DEF8",
    "button_foreground": "#1D192B",
    "button_hover": "#DDD2EE",
    "button_pressed": "#D1C5E3",
    "editor_background": "#F7F2FA",
    "editor_foreground": "#1D1B20",
    "editor_keyword": "#6750A4",
    "editor_string": "#386A20",
    "editor_number": "#7D5260",
    "editor_comment": "#79747E",
    "editor_selection": "#EADDFF",
    "table_background": "#FFFFFF",
    "table_foreground": "#1D1B20",
    "table_alternate_row": "#F7F2FA",
    "table_header_background": "#F3EDF7",
    "table_header_foreground": "#49454F",
    "table_grid": "#E7E0EC",
    "table_selection": "#EADDFF",
    "menu_background": "#F3EDF7",
    "menu_foreground": "#1D1B20",
    "menu_hover": "#E6E0E9",
    "status_background": "#F3EDF7",
    "status_foreground": "#49454F",
    "accent_primary": "#6750A4",
    "accent_secondary": "#7D5260",
    "accent_warning": "#9A5B00",
    "accent_error": "#B3261E",
    "tab_active_background": "#FEF7FF",
    "tab_active_border": "#CAC4D0",
    "tab_inactive_background": "#F3EDF7",
    "tab_inactive_border": "#CAC4D0",
    "tab_text_active": "#6750A4",
    "tab_text_inactive": "#49454F",
    "tab_close_hover": "#B3261E"

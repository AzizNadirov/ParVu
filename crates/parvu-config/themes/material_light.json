  "layout": {
    "window_min_width": 1200,
    "window_min_height": 800,
    "sql_editor_height": 100,
    "toolbar_height": 40,
    "status_bar_height": 26,
    "margin": 8,
    "spacing": 8,
    "default_font_family": "Roboto",
    "default_font_size": 10,
    "code_font_family": "Roboto Mono",
    "code_font_size": 10,
    "table_font_family": "Roboto",
    "table_font_size": 10,
    "table_row_height": 28,
    "table_header_height": 34,
    "show_grid": true,
    "alternate_row_colors": true,
    "button_min_width": 64,
    "button_height": 32,
    "button_border_radius": 20,
    "show_file_path_label": true,
    "show_table_info_button": true,
    "show_reset_button": true
  }
}

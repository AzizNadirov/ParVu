{
  "name": "Jupyter",
  "description": "JupyterLab's look: white notebook surfaces, light grey cell borders, its blue accent with Jupyter orange, and its code colours",
  "author": "ParVu",
  "version": "1.0",
  "colors": {
    "background": "#FFFFFF",
    "foreground": "#212121",
    "button_background": "#E3F2FD",
    "button_foreground": "#0D47A1",
    "button_hover": "#BBDEFB",
    "button_pressed": "#90CAF9",
    "editor_background": "#F7F7F7",
    "editor_foreground": "#212121",
    "editor_keyword": "#008000",
    "editor_string": "#BA2121",
    "editor_number": "#008800",
    "editor_comment": "#3D7A7A",
    "editor_selection": "#D9E7F9",
    "table_background": "#FFFFFF",
    "table_foreground": "#212121",
    "table_alternate_row": "#F5F5F5",
    "table_header_background": "#FFFFFF",
    "table_header_foreground": "#212121",
    "table_grid": "#E0E0E0",
    "table_selection": "#E1F5FE",
    "menu_background": "#FFFFFF",
    "menu_foreground": "#212121",
    "menu_hover": "#EEEEEE",
    "status_background": "#F5F5F5",
    "status_foreground": "#616161",
    "accent_primary": "#1976D2",
    "accent_secondary": "#F37726",
    "accent_warning": "#F57C00",
    "accent_error": "#D32F2F",
    "tab_active_background": "#FFFFFF",
    "tab_active_border": "#E0E0E0",
    "tab_inactive_background": "#EEEEEE",
    "tab_inactive_border": "#E0E0E0",
    "tab_text_active": "#212121",
    "tab_text_inactive": "#616161",
    "tab_close_hover": "#D32F2F"
  },
  "layout": {
    "window_min_width": 1200,
    "window_min_height": 800,
    "sql_editor_height": 100,
    "toolbar_height": 40,
    "status_bar_height": 26,
    "margin": 8,
    "spacing": 8,
    "default_font_family": "Segoe UI",
    "default_font_size": 10,
    "code_font_family": "DejaVu Sans Mono",
    "code_font_size": 10,
    "table_font_family": "Segoe UI",
    "table_font_size": 10,
    "table_row_height": 26,
    "table_header_height": 30,
    "show_grid": true,
    "alternate_row_colors": true,
    "button_min_width": 64,
    "button_height": 32,
    "button_border_radius": 2,
    "show_file_path_label": true,
    "show_table_info_button": true,
    "show_reset_button": true
  }
}

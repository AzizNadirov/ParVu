    "menu_hover": "#3B383E",
    "status_background": "#211F26",
    "status_foreground": "#CAC4D0",
    "accent_primary": "#D0BCFF",
    "accent_secondary": "#EFB8C8",
    "accent_warning": "#FFB869",
    "accent_error": "#F2B8B5",

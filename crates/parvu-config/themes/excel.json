{
  "name": "Excel Material",
  "description": "Excel's green in Material Design 3: tinted surfaces, tonal buttons, a green status bar and dense rows",
  "author": "ParVu",
  "version": "1.0",
  "colors": {
    "background": "#F8FBF8",
    "foreground": "#191C1A",
    "button_background": "#D2E8D9",
    "button_foreground": "#0B3D22",
    "button_hover": "#C3DFCC",
    "button_pressed": "#B2D5BE",
    "editor_background": "#F1F6F2",
    "editor_foreground": "#191C1A",
    "editor_keyword": "#107C41",
    "editor_string": "#A4262C",
    "editor_number": "#0F6CBD",
    "editor_comment": "#707970",
    "editor_selection": "#CDE7D6",
    "table_background": "#FFFFFF",
    "table_foreground": "#191C1A",
    "table_alternate_row": "#F4F9F5",
    "table_header_background": "#E7F2EA",
    "table_header_foreground": "#0B3D22",
    "table_grid": "#DCE5DE",
    "table_selection": "#CDE7D6",
    "menu_background": "#EEF5F0",
    "menu_foreground": "#191C1A",
    "menu_hover": "#E1ECE4",
    "status_background": "#107C41",
    "status_foreground": "#FFFFFF",
    "accent_primary": "#107C41",
    "accent_secondary": "#0F6CBD",
    "accent_warning": "#C25E00",
    "accent_error": "#C42B1C",
    "tab_active_background": "#FFFFFF",
    "tab_active_border": "#C7D3CA",
    "tab_inactive_background": "#EEF5F0",
    "tab_inactive_border": "#C7D3CA",
    "tab_text_active": "#107C41",
    "tab_text_inactive": "#414942",
    "tab_close_hover": "#C42B1C"
  },
  "layout": {
    "window_min_width": 1200,
    "window_min_height": 800,
    "sql_editor_height": 100,
    "toolbar_height": 40,
    "status_bar_height": 26,
    "margin": 8,
    "spacing": 8,
    "default_font_family": "Segoe UI",
    "default_font_size": 10,
    "code_font_family": "Cascadia Mono",
    "code_font_size": 10,
    "table_font_family": "Calibri",
    "table_font_size": 11,
    "table_row_height": 24,
    "table_header_height": 30,
    "show_grid": true,
    "alternate_row_colors": true,
    "button_min_width": 64,
    "button_height": 32,
    "button_border_radius": 20,
    "show_file_path_label": true,
    "show_table_info_button": true,
    "show_reset_button": true
  }
}
